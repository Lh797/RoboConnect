@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RoboConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <div class="container app-container">
                <div class="topbar-inner">
                    <a class="brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark">●</span>
                        <span>RoboConnect</span>
                    </a>

                    <nav class="topnav d-none d-md-flex">
                        <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">Home</a>
                        <a asp-controller="Home" asp-action="Discover" class="@(currentController == "Home" && currentAction == "Discover" ? "active" : "")">Discover</a>
                        <a asp-controller="Requests" asp-action="Create" class="@(currentController == "Requests" && currentAction == "Create" ? "active" : "")">Request</a>
                        <a asp-controller="Requests" asp-action="MyRequests" class="@(currentController == "Requests" && currentAction == "MyRequests" ? "active" : "")">My Requests</a>
                        <a asp-controller="Providers" asp-action="Index" class="@(currentController == "Providers" ? "active" : "")">Providers</a>
                        <a asp-controller="Hub" asp-action="Index" class="@(currentController == "Hub" ? "active" : "")">Hub</a>
                        <a asp-controller="Chat" asp-action="Index" class="@(currentController == "Chat" ? "active" : "")">Chat</a>
                        <a asp-controller="Dashboard" asp-action="Index" class="@(currentController == "Dashboard" ? "active" : "")">Dashboard</a>
                        <a href="#footer">Contact</a>
                    </nav>

                    <a class="nav-cta d-none d-md-inline-flex" asp-controller="Requests" asp-action="Create">
                        Submit Request
                    </a>
                </div>
            </div>
        </header>

        <main class="main-content">
            <div class="container app-container">
                @RenderBody()
            </div>
        </main>

        <footer id="footer" class="site-footer">
            <div class="container app-container">
                <div class="footer-card">
                    <h2 class="footer-brand">RoboConnect</h2>

                    <div class="footer-grid">
                        <div>
                            <h3>Company</h3>
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a asp-controller="Home" asp-action="Discover">Discover</a></li>
                                <li><a asp-controller="Requests" asp-action="Create">Request</a></li>
                                <li><a asp-controller="Requests" asp-action="MyRequests">My Requests</a></li>
                                <li><a asp-controller="Providers" asp-action="Index">Providers</a></li>
                                <li><a asp-controller="Hub" asp-action="Index">Hub</a></li>
                                <li><a asp-controller="Chat" asp-action="Index">Chat</a></li>
                                <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            </ul>
                        </div>

                        <div>
                            <h3>Social</h3>
                            <ul>
                                <li><a href="#">Facebook</a></li>
                                <li><a href="#">Twitter</a></li>
                                <li><a href="#">LinkedIn</a></li>
                                <li><a href="#">Instagram</a></li>
                            </ul>
                        </div>

                        <div>
                            <h3>Integrations</h3>
                            <ul>
                                <li><a href="#">Slack</a></li>
                                <li><a href="#">Asana</a></li>
                                <li><a href="#">Jira</a></li>
                                <li><a href="#">Trello</a></li>
                            </ul>
                        </div>

                        <div>
                            <h3>Legal</h3>
                            <ul>
                                <li><a href="#">Privacy Policy</a></li>
                                <li><a href="#">Terms of Service</a></li>
                                <li><a href="#">Security</a></li>
                                <li><a href="#">Accessibility</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="footer-bottom">
                        <span>2026 © RoboConnect. All rights reserved.</span>
                    </div>
                </div>
            </div>
        </footer>

        <nav class="bottom-nav d-md-none">
            <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                <span class="bottom-icon">⌂</span>
                <span>Home</span>
            </a>
            <a asp-controller="Requests" asp-action="Create" class="@(currentController == "Requests" ? "active" : "")">
                <span class="bottom-icon">➤</span>
                <span>Request</span>
            </a>
            <a asp-controller="Hub" asp-action="Index" class="@(currentController == "Hub" ? "active" : "")">
                <span class="bottom-icon">◈</span>
                <span>Hub</span>
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="@(currentController == "Dashboard" ? "active" : "")">
                <span class="bottom-icon">▣</span>
                <span>Stats</span>
            </a>
        </nav>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>